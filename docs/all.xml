	&lt;img src="https://calendar.ou.edu/live/image/gid/32/width/80/height/80/crop/1/src_region/0,0,600,600/3189_cfe_event_image.rev.1611607360.png" alt="" width="80" height="80" srcset="https://calendar.ou.edu/live/image/scale/2x/gid/32/width/80/height/80/crop/1/src_region/0,0,600,600/3189_cfe_event_image.rev.1611607360.png 2x, https://calendar.ou.edu/live/image/scale/3x/gid/32/width/80/height/80/crop/1/src_region/0,0,600,600/3189_cfe_event_image.rev.1611607360.png 3x" data-max-w="600" data-max-h="600" loading="lazy" data-optimized="true"/&gt;
